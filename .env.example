# 服务
APP_ENV=dev
APP_TOKEN=dev-token-change-me

# 数据库（个人本地 agent：默认 SQLite 单文件；企业部署可选 Postgres，见 docs/08）
DATABASE_URL=sqlite+pysqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/satellite

# LLM 供应商（STUB_LLM 未设置时：无可用供应商自动进入桩模式）
# 也可以不改这里：用前端「设置」页配置任意第三方（运行时存储，保存即生效）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# 供应商注册表可选调优
# LLM_ORDER=deepseek,qwen            # 按 id 过滤 / 重排降级链
# LLM_TIMEOUT_S=120
# PRICE_<ID>_IN= / PRICE_<ID>_OUT=   # 元 / 1K tokens，用于成本估算

# 行为开关
EMBEDDING_BACKEND=hashing          # hashing（默认，零依赖）| bge-m3（需 sentence-transformers）
EMBEDDING_MODEL=BAAI/bge-m3
ORBIT_CROSSCHECK=1                 # 0 = 跳过 skyfield/SGP4 交叉验证
STUB_LLM=
COST_LIMIT_CNY=3
LOG_LEVEL=INFO
