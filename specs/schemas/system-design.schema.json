{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satellite.local/schemas/system-design.schema.json",
  "title": "SystemDesign",
  "description": "整星方案（构型 / 分系统 / 指标树）。对应 docs/03-data-model.md §3.2",
  "type": "object",
  "required": ["configuration", "subsystems", "metrics", "version", "created_at"],
  "additionalProperties": false,
  "properties": {
    "configuration": {
      "type": "object",
      "required": ["type", "envelope_mm"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "example": "3-axis-stabilized", "description": "构型类型" },
        "envelope_mm": {
          "type": "object",
          "required": ["x", "y", "z"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "exclusiveMinimum": 0 },
            "y": { "type": "number", "exclusiveMinimum": 0 },
            "z": { "type": "number", "exclusiveMinimum": 0 }
          },
          "description": "包络尺寸（毫米）"
        },
        "notes": { "type": "string" }
      }
    },
    "subsystems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "module", "status"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "module": {
            "type": "string",
            "enum": ["system", "power", "ttc", "data", "adcs", "orbit", "payload", "risk", "other"]
          },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["proposed", "confirmed", "rejected"] }
        }
      }
    },
    "metrics": {
      "type": "array",
      "description": "指标树叶子",
      "items": {
        "type": "object",
        "required": ["param_id", "target_value", "unit"],
        "additionalProperties": false,
        "properties": {
          "param_id": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_.]+$" },
          "target_value": { "type": "number" },
          "unit": { "type": "string" }
        }
      }
    },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "examples": [
    {
      "configuration": {
        "type": "3-axis-stabilized",
        "envelope_mm": { "x": 800, "y": 800, "z": 1200 },
        "notes": "立方星平台改装，太阳翼两组对日定向"
      },
      "subsystems": [
        { "name": "电源分系统", "module": "power", "description": "太阳翼 + 锂离子电池组", "status": "proposed" },
        { "name": "测控数传分系统", "module": "ttc", "description": "S 频段测控 + X 频段数传", "status": "proposed" }
      ],
      "metrics": [
        { "param_id": "payload.gsd_m", "target_value": 5, "unit": "m" },
        { "param_id": "mass.total_with_margin", "target_value": 80, "unit": "kg" }
      ],
      "version": 1,
      "created_at": "2026-10-05T09:01:00Z"
    }
  ]
}
