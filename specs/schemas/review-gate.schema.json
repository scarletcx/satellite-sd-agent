{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satellite.local/schemas/review-gate.schema.json",
  "title": "ReviewGate",
  "description": "人工门禁记录（谁、何时、结论）。对应 docs/03-data-model.md §3.10",
  "type": "object",
  "required": ["id", "mission_id", "type", "action", "reviewer", "comment", "ts"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^g-[0-9]{3,}$", "example": "g-003" },
    "mission_id": { "type": "string", "pattern": "^t-[0-9]{8}-[0-9]{3}$" },
    "type": {
      "type": "string",
      "enum": ["assumption_confirm", "discrepancy_resolve", "final_review"]
    },
    "param_id": { "type": ["string", "null"], "description": "关联参数 id" },
    "action": { "type": "string", "enum": ["accept", "reject"] },
    "reviewer": { "type": "string", "maxLength": 100 },
    "comment": { "type": "string", "maxLength": 500 },
    "ts": { "type": "string", "format": "date-time" }
  },
  "examples": [
    {
      "id": "g-003",
      "mission_id": "t-20261005-001",
      "type": "assumption_confirm",
      "param_id": "mass.margin_pct",
      "action": "accept",
      "reviewer": "engineer@example.com",
      "comment": "按工程经验接受 10% 余量",
      "ts": "2026-10-05T09:05:00Z"
    }
  ]
}
